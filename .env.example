# AI provider
# When set, direct OpenAI/OpenAI-compatible chat is used instead of Lovable AI.
OPENAI_API_KEY=
# Optional: set this for an OpenAI-compatible provider such as a self-hosted gateway.
OPENAI_BASE_URL=
SVARGA_OPENAI_FAST_MODEL=gpt-4.1-mini
SVARGA_OPENAI_REASONING_MODEL=gpt-4.1
SVARGA_OPENAI_CREATIVE_MODEL=gpt-4.1-mini

# Legacy Lovable AI fallback (used only when OPENAI_API_KEY is not set)
LOVABLE_API_KEY=
LOVABLE_AI_BASE_URL=https://ai.gateway.lovable.dev/v1
SVARGA_FAST_MODEL=openai/gpt-6-astra
SVARGA_REASONING_MODEL=openai/gpt-6-astra
SVARGA_CREATIVE_MODEL=openai/gpt-6-astra
SVARGA_RAG_ENABLED=false
SVARGA_RAG_TOP_K=6

# Payments (server only; never expose the secret to the browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Comma-separated allowed order amounts in paise, e.g. 49900,499900
RAZORPAY_ALLOWED_AMOUNTS_PAISE=

# Supabase (use the existing project values)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
