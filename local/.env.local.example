# Copy to local/.env.local and fill in. Never commit the filled file.

# Svarga database (owner access — keep private)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Your own Svarga account id, used to load your library + memory
SVARGA_OWNER_USER_ID=

# Local model runtime
OLLAMA_URL=http://localhost:11434
LOCAL_MODEL=llama3.2:3b-instruct-q4_K_M

# Training
BASE_MODEL=unsloth/Llama-3.2-3B-Instruct-bnb-4bit
